// Accelerator
//

IDR_MAINFRAME ACCELERATORS 
BEGIN
    VK_INSERT,      ID_FILE_ADD,            VIRTKEY, NOINVERT
    VK_DELETE,      ID_FILE_DELETE,         VIRTKEY, NOINVERT
    VK_RETURN,      ID_FILE_EDIT,           VIRTKEY, NOINVERT
    VK_DELETE,      ID_FILE_HISTORY,        VIRTKEY, CONTROL, NOINVERT
    VK_RETURN,      ID_FILE_INFO,           VIRTKEY, ALT, NOINVERT
    "S",            ID_FILE_START,          VIRTKEY, CONTROL, NOINVERT
    "S",            ID_FILE_STOP,           VIRTKEY, SHIFT, CONTROL, 
                                                    NOINVERT
    VK_RETURN,      ID_FILE_SUBMIT,         VIRTKEY, CONTROL, NOINVERT
    VK_DOWN,        ID_PRIOR_BOTTOM,        VIRTKEY, CONTROL, NOINVERT
    VK_DOWN,        ID_PRIOR_DOWN,          VIRTKEY, SHIFT, NOINVERT
    VK_UP,          ID_PRIOR_TOP,           VIRTKEY, CONTROL, NOINVERT
    VK_UP,          ID_PRIOR_UP,            VIRTKEY, SHIFT, NOINVERT
    "L",            ID_TOOLS_LOGIN,         VIRTKEY, CONTROL, NOINVERT
    "H",            ID_VIEW_HISTORY,        VIRTKEY, CONTROL, NOINVERT
    "Q",            ID_VIEW_QUEUE,          VIRTKEY, CONTROL, NOINVERT
    VK_F5,          ID_VIEW_RELOAD,         VIRTKEY, NOINVERT
    "T",            ID_VIEW_TERM,           VIRTKEY, CONTROL, NOINVERT
END


