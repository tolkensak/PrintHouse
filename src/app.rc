IDR_MAINFRAME MENU 
BEGIN
    POPUP "&Файл"
    BEGIN
        MENUITEM "&Вход...\tCtrl+L",            ID_TOOLS_LOGIN
        MENUITEM SEPARATOR
        MENUITEM "В&ыход",                      ID_APP_EXIT
    END
    POPUP "&Вид"
    BEGIN
        MENUITEM "Панели &инструментов",        ID_VIEW_TOOLBAR
        MENUITEM "Строка &состояния",           ID_VIEW_STATUS_BAR
        MENUITEM "Панель &процессов",           ID_VIEW_PROCESS_BAR
        MENUITEM SEPARATOR
        MENUITEM "&Очередь\tCtrl+Q",            ID_VIEW_QUEUE
        MENUITEM "&Архив\tCtrl+H",              ID_VIEW_HISTORY
        MENUITEM SEPARATOR
        MENUITEM "&Критерия...\tCtrl+T",        ID_VIEW_TERM
        MENUITEM SEPARATOR
        MENUITEM "О&бновить\tF5",               ID_VIEW_RELOAD
    END
    POPUP "&Задача"
    BEGIN
        MENUITEM "&Создать...\tInsert",         ID_FILE_ADD
        MENUITEM "&Изменить...\tEnter",         ID_FILE_EDIT
        MENUITEM "&Удалить\tDelete",            ID_FILE_DELETE
        MENUITEM SEPARATOR
        POPUP "&Приоритет"
        BEGIN
            MENUITEM "&Первый\tCtrl+Up",            ID_PRIOR_TOP
            MENUITEM "&Вверх\tShift+Up",            ID_PRIOR_UP
            MENUITEM "В&низ\tShift+Down",           ID_PRIOR_DOWN
            MENUITEM "П&оследний\tCtrl+Down",       ID_PRIOR_BOTTOM
        END
        MENUITEM SEPARATOR
        MENUITEM "С&тарт\tCtrl+S",              ID_FILE_START
        MENUITEM "Ст&оп\tCtrl+Shift+S",         ID_FILE_STOP
        MENUITEM "&Архивировать\tCtrl+Delete",  ID_FILE_HISTORY
        MENUITEM "&Пометить\tCtrl+Enter",       ID_FILE_SUBMIT
        MENUITEM SEPARATOR
        MENUITEM "&Информация...\tAlt+Enter",   ID_FILE_INFO
    END
    POPUP "&Сервис"
    BEGIN
        MENUITEM "&Изменить пароль...",         ID_TOOLS_PASS
        MENUITEM "&Пользователи...",            ID_TOOLS_USERS
        MENUITEM SEPARATOR
        MENUITEM "&Настройка...",               ID_TOOLS_OPTIONS
    END
    POPUP "С&правка"
    BEGIN
        MENUITEM "&О программе",                ID_APP_ABOUT
    END
END


